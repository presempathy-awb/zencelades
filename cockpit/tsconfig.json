{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "resolveJsonModule": true,
    "allowJs": true, "skipLibCheck": true, "esModuleInterop": true,
    "types": ["bun", "vite/client"], "noUnusedLocals": true, "noUnusedParameters": true
  },
  "include": ["src", "scripts", "vite.config.ts"]
}
