# Proposed additions inside the existing loopback site block, before file_server.
# Do not activate until the service and canonical Authentik provider are verified.
# Public pages remain public; the Go API verifies the session on every request.
reverse_proxy /account/api/* 127.0.0.1:18134
reverse_proxy /outpost.goauthentik.io/* 127.0.0.1:19001
